<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backups and device transfers. Art packs are large and the user's own files, so they're left out. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="artpacks/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="artpacks/" />
    </device-transfer>
</data-extraction-rules>
