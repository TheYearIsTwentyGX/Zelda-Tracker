<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8–12 icon. The monochrome (themed icon) layer lives in mipmap-anydpi-v33: adding it
    here makes aapt2 version this file to v33 and leaves older devices with no launcher icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MonochromeLauncherIcon">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
