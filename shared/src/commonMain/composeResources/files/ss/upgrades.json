{
  "sections": [
    {
      "id": "items",
      "title": "Items",
      "note": "Gondo upgrades these at his Scrap Shop in the Bazaar; he offers only what you're carrying. Items & Equipment shares this progress."
    },
    {
      "id": "shields",
      "title": "Shields",
      "note": "Gondo upgrades and repairs them. The Hylian Shield can't be upgraded. The Shields checklist shares this progress."
    },
    {
      "id": "pouch",
      "title": "Pouch Items",
      "note": "You can carry several of each in Adventure Pouch slots. Track each one; the totals count one of each. Your first of each shares its progress with Items & Equipment."
    },
    {
      "id": "potions",
      "title": "Potions",
      "optional": "Potions",
      "note": "Luv sells them at the Potion Shop in the Bazaar and Bertie infuses them with bugs. The Potion Infusions recipe book shares this progress."
    }
  ],
  "materials": [
    {
      "id": "skyloft_mantis",
      "name": "Skyloft Mantis",
      "kind": "BUG",
      "farm": "On trees around Skyloft. Easy to catch.",
      "regions": [
        "Skyloft"
      ],
      "gameOrder": 1
    },
    {
      "id": "sky_stag_beetle",
      "name": "Sky Stag Beetle",
      "kind": "BUG",
      "farm": "On trees around Skyloft: roll into the trunk to knock it down.",
      "regions": [
        "Skyloft"
      ],
      "gameOrder": 2
    },
    {
      "id": "starry_firefly",
      "name": "Starry Firefly",
      "kind": "BUG",
      "farm": "Skyloft at night, the Waterfall Cave, Pumpkin Landing and Beedle's Island at night.",
      "regions": [
        "Skyloft",
        "The Sky",
        "Night"
      ],
      "gameOrder": 3
    },
    {
      "id": "blessed_butterfly",
      "name": "Blessed Butterfly",
      "kind": "BUG",
      "farm": "Everywhere in the Sky and on the Surface; they gather where a Goddess Wall or a harp spot is.",
      "regions": [
        "Everywhere"
      ],
      "gameOrder": 4
    },
    {
      "id": "woodland_rhino_beetle",
      "name": "Woodland Rhino Beetle",
      "kind": "BUG",
      "farm": "On tree trunks in Faron Woods and the Deep Woods: roll into the tree to knock it down. Slow and easy to catch.",
      "regions": [
        "Faron Woods",
        "Skyloft"
      ],
      "gameOrder": 5
    },
    {
      "id": "deku_hornet",
      "name": "Deku Hornet",
      "kind": "BUG",
      "farm": "Around the hornet nests of the Deep Woods; knock a nest down and catch the swarm. Bug Rock in the Thunderhead has them too.",
      "regions": [
        "Faron Woods",
        "Thunderhead"
      ],
      "gameOrder": 6
    },
    {
      "id": "faron_grasshopper",
      "name": "Faron Grasshopper",
      "kind": "BUG",
      "farm": "In the grass of Faron Woods, the Deep Woods and the Sealed Grounds. It leaps away: creep up slowly.",
      "regions": [
        "Faron Woods",
        "Sealed Grounds"
      ],
      "gameOrder": 7
    },
    {
      "id": "volcanic_ladybug",
      "name": "Volcanic Ladybug",
      "kind": "BUG",
      "farm": "In groups on Eldin Volcano. Barely moves.",
      "regions": [
        "Eldin Volcano"
      ],
      "gameOrder": 8
    },
    {
      "id": "eldin_roller",
      "name": "Eldin Roller",
      "kind": "BUG",
      "farm": "Rare on Eldin Volcano, rolling a ball along the ground.",
      "regions": [
        "Eldin Volcano"
      ],
      "gameOrder": 9
    },
    {
      "id": "lanayru_ant",
      "name": "Lanayru Ant",
      "kind": "BUG",
      "farm": "In swarms at the Lanayru Mine, in Lanayru Desert and at the Temple of Time.",
      "regions": [
        "Lanayru Mine",
        "Lanayru Desert"
      ],
      "gameOrder": 10
    },
    {
      "id": "gerudo_dragonfly",
      "name": "Gerudo Dragonfly",
      "kind": "BUG",
      "farm": "In Lanayru Desert. It flies far once disturbed: creep up on it.",
      "regions": [
        "Lanayru Desert"
      ],
      "gameOrder": 11
    },
    {
      "id": "sand_cicada",
      "name": "Sand Cicada",
      "kind": "BUG",
      "farm": "On trees and walls in Lanayru Desert, and on Skipper's Retreat. The hardest bug to catch: it flies off quickly.",
      "regions": [
        "Lanayru Desert",
        "Lanayru Sand Sea"
      ],
      "gameOrder": 12
    },
    {
      "id": "amber_relic",
      "name": "Amber Relic",
      "kind": "TREASURE",
      "farm": "Everywhere: lying around the Surface, in pots and in chests.",
      "regions": [
        "Everywhere"
      ],
      "gameOrder": 13
    },
    {
      "id": "hornet_larvae",
      "name": "Hornet Larvae",
      "kind": "TREASURE",
      "farm": "Knock down a Deku Hornet nest (roll into its tree, or hit it with the Slingshot or Beetle) and pick them up.",
      "regions": [
        "Faron Woods"
      ],
      "gameOrder": 14
    },
    {
      "id": "jelly_blob",
      "name": "Jelly Blob",
      "kind": "TREASURE",
      "farm": "Dropped by Deku Babas, ChuChus and Arachas.",
      "regions": [
        "Enemy drop"
      ],
      "gameOrder": 15
    },
    {
      "id": "bird_feather",
      "name": "Bird Feather",
      "kind": "TREASURE",
      "farm": "Catch a Chirri, the little birds of Faron Woods and the Sealed Grounds, with the Bug Net.",
      "regions": [
        "Faron Woods",
        "Sealed Grounds"
      ],
      "gameOrder": 16
    },
    {
      "id": "blue_bird_feather",
      "name": "Blue Bird Feather",
      "kind": "TREASURE",
      "farm": "Catch a rare blue Chirri in Faron Woods or the Sealed Grounds with the Bug Net. The Moonlight Merchant sells them late in the game.",
      "regions": [
        "Faron Woods",
        "Sealed Grounds"
      ],
      "gameOrder": 17
    },
    {
      "id": "monster_claw",
      "name": "Monster Claw",
      "kind": "TREASURE",
      "farm": "Dropped by Keese, Walltulas and Guays.",
      "regions": [
        "Enemy drop"
      ],
      "gameOrder": 18
    },
    {
      "id": "ornamental_skull",
      "name": "Ornamental Skull",
      "kind": "TREASURE",
      "farm": "Dropped by Bokoblins, or whip it off one.",
      "regions": [
        "Enemy drop"
      ],
      "gameOrder": 19
    },
    {
      "id": "golden_skull",
      "name": "Golden Skull",
      "kind": "TREASURE",
      "farm": "Rarely from Bokoblins (whip it off one that carries it), in some chests, from the Clean Cut minigame on Bamboo Island, or from the Moonlight Merchant.",
      "regions": [
        "Enemy drop",
        "The Sky"
      ],
      "gameOrder": 20
    },
    {
      "id": "eldin_ore",
      "name": "Eldin Ore",
      "kind": "TREASURE",
      "farm": "Dig it up from soft-soil spots on Eldin Volcano with the Digging Mitts.",
      "regions": [
        "Eldin Volcano"
      ],
      "gameOrder": 21
    },
    {
      "id": "lizard_tail",
      "name": "Lizard Tail",
      "kind": "TREASURE",
      "farm": "Dropped by Lizalfos, first met in the Earth Temple.",
      "regions": [
        "Enemy drop"
      ],
      "gameOrder": 22
    },
    {
      "id": "tumbleweed",
      "name": "Tumbleweed",
      "kind": "TREASURE",
      "farm": "Catch one rolling across Lanayru Desert with the Bug Net.",
      "regions": [
        "Lanayru Desert"
      ],
      "gameOrder": 23
    },
    {
      "id": "ancient_flower",
      "name": "Ancient Flower",
      "kind": "TREASURE",
      "farm": "Only blooms around an active Timeshift Stone, in Lanayru Desert, the Sand Sea and the Pirate Stronghold.",
      "regions": [
        "Lanayru Desert",
        "Lanayru Sand Sea"
      ],
      "gameOrder": 24
    },
    {
      "id": "dusk_relic",
      "name": "Dusk Relic",
      "kind": "TREASURE",
      "farm": "Only in the Silent Realms, including replays in Lanayru's Lightning Round, or from the Moonlight Merchant.",
      "regions": [
        "Silent Realm"
      ],
      "gameOrder": 25
    },
    {
      "id": "evil_crystal",
      "name": "Evil Crystal",
      "kind": "TREASURE",
      "farm": "Dropped by Cursed Bokoblins and Dark Keese; also in some chests, from Clean Cut and from the Moonlight Merchant.",
      "regions": [
        "Enemy drop"
      ],
      "gameOrder": 26
    },
    {
      "id": "monster_horn",
      "name": "Monster Horn",
      "kind": "TREASURE",
      "farm": "Whip the horn from a Bokoblin leader before he blows it; also in some chests and from the Moonlight Merchant.",
      "regions": [
        "Enemy drop"
      ],
      "gameOrder": 27
    },
    {
      "id": "goddess_plume",
      "name": "Goddess Plume",
      "kind": "TREASURE",
      "farm": "Rare: in some chests, sometimes in place of an Amber or Dusk Relic, from Thrill Digger and Clean Cut, or from the Moonlight Merchant.",
      "regions": [
        "The Sky"
      ],
      "gameOrder": 28
    }
  ],
